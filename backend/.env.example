# Interview Reviewer backend settings. Copy the values you need into your environment.
# Never commit real secrets.

# Application
IR_APP_ENV=development
IR_DATABASE_URL=postgresql+psycopg://ir:ir@localhost:5432/interview_reviewer
IR_STORAGE_DIR=./storage
IR_FRONTEND_BASE_URL=http://localhost:4200
IR_COOKIE_SECURE=false

# Authentication and tokens
IR_SESSION_TTL_HOURS=168
IR_VERIFICATION_TTL_MINUTES=1440
IR_RESET_TTL_MINUTES=60
IR_GOOGLE_LINK_TTL_MINUTES=15
IR_LOGIN_MAX_FAILURES=5
IR_LOGIN_LOCK_MINUTES=15
# Required. Use a long random value.
IR_THROTTLE_SECRET=

# SMTP
IR_SMTP_HOST=localhost
IR_SMTP_PORT=1025
IR_SMTP_USER=
IR_SMTP_PASSWORD=
IR_SMTP_FROM=no-reply@interview-reviewer.local
IR_SMTP_STARTTLS=false

# Google sign-in (client id and secret are required only for Google sign-in)
IR_GOOGLE_CLIENT_ID=
IR_GOOGLE_CLIENT_SECRET=
IR_GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback
# Required. Use a long random value.
IR_OIDC_STATE_SECRET=

# Background jobs
IR_JOB_POLL_SECONDS=2

# LLM (private infrastructure only)
IR_LLM_BASE_URL=http://localhost:11434/v1
# Development model only.
IR_LLM_MODEL=qwen2.5:7b-instruct
IR_LLM_ALLOWED_HOSTS=["localhost", "127.0.0.1", "llm"]
IR_LLM_TIMEOUT_SECONDS=120
IR_LLM_MAX_ATTEMPTS=3
IR_LLM_CONFIG_VERSION=cfg-1
IR_RUBRIC_VERSION=rubric-1

# Legal documents
IR_TERMS_VERSION=terms-2026-09
IR_PRIVACY_VERSION=privacy-2026-09

# Limits
IR_MAX_PDF_BYTES=5242880
IR_MAX_RESUMES_PER_USER=10
IR_MAX_ANSWER_CHARS=5000
IR_SESSION_EXPIRY_DAYS=30
IR_MAX_REQUIRED_SKILLS=20
IR_MIN_RESUME_TEXT_CHARS=200
IR_OCR_ENABLED=false

# Knowledge base, model targets and validation
IR_KNOWLEDGE_SOURCES_PATH=config/approved_sources.yaml
IR_KNOWLEDGE_MIN_RANK=0.01
IR_MODEL_TARGETS_PATH=config/model_targets.yaml
IR_VALIDATION_REPORTS_DIR=validation_reports
